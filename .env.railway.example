# ==============================================================================
# Railway Production Environment Variables for Foodigo
# Copy and paste these into your Railway Service -> Variables -> Raw Editor
# ==============================================================================

APP_NAME="Foodigo"
APP_ENV=production
APP_KEY=base64:sYBLLPU5JmGSyqjXPot4OsBcOYRKKNO5u/htpDyLj+8=
APP_DEBUG=false
APP_URL=https://${{RAILWAY_PUBLIC_DOMAIN}}

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

# ------------------------------------------------------------------------------
# Railway MySQL Database Connection
# Dynamically references Railway's internal MySQL service
# ------------------------------------------------------------------------------
DB_CONNECTION=mysql
DB_HOST=${{MySQL.MYSQLHOST}}
DB_PORT=${{MySQL.MYSQLPORT}}
DB_DATABASE=${{MySQL.MYSQLDATABASE}}
DB_USERNAME=${{MySQL.MYSQLUSER}}
DB_PASSWORD=${{MySQL.MYSQLPASSWORD}}

# ------------------------------------------------------------------------------
# App Drivers & Cache
# ------------------------------------------------------------------------------
BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

# ------------------------------------------------------------------------------
# Nixpacks Nginx Document Root
# ------------------------------------------------------------------------------
NIXPACKS_PHP_ROOT_DIR=/app/public
NIXPACKS_PHP_FALLBACK_PATH=/index.php

# ------------------------------------------------------------------------------
# App Mode & Third-party integrations
# ------------------------------------------------------------------------------
APP_MODE=LIVE
Global_SEARCH=DISABLE
MAP_API=
